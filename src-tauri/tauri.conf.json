{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Noor Al-Quran",
  "version": "1.29.3",
  "identifier": "com.nooralquran.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run scripts/sync-version.ts && bun run dev",
    "beforeBuildCommand": "bun run scripts/sync-version.ts && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noor Al-Quran (نور القرآن) - Authentic Noble Quran Workstation",
        "url": "index.html",
        "width": 1366,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
